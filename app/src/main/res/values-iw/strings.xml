    <string name="tts_gemini">‏Google Gemini (מפתח חינמי, מומלץ)</string>
    <string name="tts_gemini_desc">קולות טבעיים מאוד בעברית ובאנגלית. מפתח חינמי מ־Google AI Studio דורש רק חשבון Google, בלי כרטיס אשראי. המסלול החינמי מכסה מספר מוגבל של הודעות ביום; את השאר מקריאים הקולות הלא־מקוונים.</string>
    <string name="tts_azure">מיקרוסופט Azure (מפתח משלך)</string>
    <string name="tts_azure_desc">משתמש במפתח Azure Speech שלך (במסלול החינמי: 500,000 תווים בחודש; ההרשמה ל־Azure דורשת כרטיס אשראי).</string>
    <string name="tts_none">ללא, רק קולות לא־מקוונים</string>
    <string name="tts_none_desc">שום דבר לא נשלח לרשת; ההודעות מוקראות בקולות הלא־מקוונים שלהלן.</string>
