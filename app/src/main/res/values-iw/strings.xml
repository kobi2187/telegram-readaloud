    <string name="gemini_ok">המפתח תקין. השמע של Gemini יורד בסנכרון הבא.</string>
    <string name="gemini_bad_key">המפתח נדחה על ידי Google. העתיקו אותו שוב מ־Google AI Studio.</string>
    <string name="gemini_quota">הבקשות החינמיות של Gemini להיום נוצלו; הקולות הלא־מקוונים מקריאים עד שהמכסה תתחדש (בחצות לפי שעון החוף המערבי של ארה״ב, בערך 10:00 בבוקר בישראל).</string>
